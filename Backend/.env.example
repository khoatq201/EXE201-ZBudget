# MongoDB Configuration
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/database_name
MONGODB_TEST_URI=mongodb://localhost:27017/zbudget_test

# Server Configuration
PORT=3000
NODE_ENV=production  # Use 'development' for local development

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your_refresh_secret_change_this_in_production
JWT_REFRESH_EXPIRES_IN=30d

# Password Configuration
BCRYPT_ROUNDS=12

# ============================================
# RATE LIMITING CONFIGURATION
# ============================================
# Adjust these values based on your expected traffic
# For 1000 users with moderate usage:

# General API Rate Limit (all endpoints)
RATE_LIMIT_WINDOW_MS=900000                    # 15 minutes window
RATE_LIMIT_MAX_REQUESTS=500                    # 500 requests per 15 min per IP

# Authentication Routes (login, register, refresh token)
RATE_LIMIT_AUTH_MAX_REQUESTS=50                # 50 auth requests per 15 min per IP
                                               # Default was 5, increased for production

# Password Routes (forgot password, reset password, change password)
RATE_LIMIT_PASSWORD_WINDOW_MS=300000           # 5 minutes window
RATE_LIMIT_PASSWORD_MAX_REQUESTS=10            # 10 password attempts per 5 min per IP
                                               # Default was 3, increased for production

# Recommendations by user scale:
# - 100 users:  AUTH=20, GENERAL=200
# - 1000 users: AUTH=50, GENERAL=500 (current)
# - 5000 users: AUTH=100, GENERAL=1000
# - 10000+ users: Consider Redis-based rate limiting

# Email Configuration
# ⚠️ IMPORTANT: Render Free Tier blocks ports 25, 465, 587
# For Render free tier, use SMTP service with port 2525 (SMTP2GO, Mailgun, SendGrid)
# For local development, Gmail works fine

# Option 1: Gmail (works locally, NOT on Render free tier)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_specific_password           # Use app-specific password, not regular password

# Option 2: SMTP with port 2525 (works on Render free tier)
# Uncomment these for Render deployment:
# SMTP_HOST=smtp.smtp2go.com                    # or mail.smtp2go.com, smtp.sendgrid.net, smtp.mailgun.org
# SMTP_PORT=2525                                # Port 2525 is NOT blocked by Render
# EMAIL_USER=your_smtp_username
# EMAIL_PASS=your_smtp_password

# EMAIL_FROM=ZBudget <noreply@zbudget.com>

# Cloudinary Configuration (for image uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
USE_CLOUDINARY=true

# Frontend Configuration
FRONTEND_URL=https://your-frontend-domain.com   # Change to your actual frontend URL

# CORS Configuration (comma-separated allowed origins)
CORS_ORIGINS=https://your-frontend-domain.com,https://www.your-frontend-domain.com

# Security
HELMET_CSP=true
TRUST_PROXY=true                                # Important for rate limiting behind reverse proxy

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# AI Services (Optional - for financial analysis features)
GEMINI_API_KEY=your_gemini_api_key              # Google AI for analysis
GROQ_API_KEY=your_groq_api_key                  # Alternative AI service

# Logging
LOG_LEVEL=info                                  # Use 'debug' for development, 'info' for production

# ============================================
# PRODUCTION CHECKLIST
# ============================================
# Before deploying to production:
# [ ] Change all secret keys (JWT_SECRET, JWT_REFRESH_SECRET)
# [ ] Update MONGODB_URI to production database
# [ ] Set NODE_ENV=production
# [ ] Update FRONTEND_URL and CORS_ORIGINS
# [ ] Configure proper email service
# [ ] Set up Cloudinary account
# [ ] Configure Google OAuth properly
# [ ] Review and adjust rate limits based on expected traffic
# [ ] Set TRUST_PROXY=true if behind nginx/cloudflare
# [ ] Enable SSL/HTTPS
