{
  "name": "zbudget-backend",
  "version": "1.0.0",
  "description": "ZBudget Personal Finance Management API",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "db:stats": "node -e \"import('./models/index.js').then(m => m.dbUtils.getStats().then(console.log))\"",
    "db:health": "node -e \"import('./models/index.js').then(m => m.dbUtils.healthCheck().then(console.log))\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint . --ext .js",
    "lint:fix": "eslint . --ext .js --fix",
    "format": "prettier --write ./**/*.js",
    "docs": "jsdoc . -d docs/"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "axios": "^1.12.2",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^2.4.3",
    "chalk": "^5.6.2",
    "cloudinary": "^1.41.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "debug": "^4.4.3",
    "dotenv": "^16.0.0",
    "express": "^4.18.0",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.0.0",
    "geoip-lite": "^1.4.10",
    "google-auth-library": "^10.3.0",
    "helmet": "^7.0.0",
    "joi": "^17.11.0",
    "jsonwebtoken": "^9.0.0",
    "mongoose": "^8.0.0",
    "morgan": "^1.10.1",
    "multer": "^1.4.4",
    "multer-storage-cloudinary": "^4.0.0",
    "node-cron": "^4.2.1",
    "nodemailer": "^6.9.7",
    "qrcode": "^1.5.4",
    "speakeasy": "^2.0.0",
    "ua-parser-js": "^2.0.5",
    "validator": "^13.7.0",
    "winston": "^3.17.0",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "jest": "^29.0.0",
    "node-fetch": "^2.7.0",
    "nodemon": "^3.1.10"
  },
  "keywords": [
    "finance",
    "budget",
    "mongoose",
    "express",
    "mongodb"
  ],
  "author": "ZBudget Team",
  "license": "MIT"
}
