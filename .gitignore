# ===============================
# Project-wide .gitignore
# ===============================

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
*~

# IDE files
.vscode/
.idea/
*.swp
*.swo
*~

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# ===============================
# Backend (Node.js) specific
# ===============================

# Dependencies
Backend/node_modules/
Backend/npm-debug.log*
Backend/yarn-debug.log*
Backend/yarn-error.log*

# Environment variables
Backend/.env
Backend/.env.local
Backend/.env.production
Backend/.env.test

# Runtime data
Backend/pids
Backend/*.pid
Backend/*.seed
Backend/*.pid.lock

# Coverage directory
Backend/coverage/
Backend/*.lcov
Backend/.nyc_output

# Optional npm cache directory
Backend/.npm

# Optional REPL history
Backend/.node_repl_history

# Output of 'npm pack'
Backend/*.tgz

# Yarn Integrity file
Backend/.yarn-integrity

# dotenv environment variables file
Backend/.env
Backend/.env.test

# parcel-bundler cache (https://parceljs.org/)
Backend/.cache
Backend/.parcel-cache

# Next.js build output
Backend/.next

# Nuxt.js build / generate output
Backend/.nuxt
Backend/dist

# Gatsby files
Backend/.cache/
Backend/public

# Serverless directories
Backend/.serverless/

# FuseBox cache
Backend/.fusebox/

# DynamoDB Local files
Backend/.dynamodb/

# TernJS port file
Backend/.tern-port

# ===============================
# Flutter/Dart specific
# ===============================

# Flutter/Dart/Pub related
zbudget/**/doc/api/
zbudget/**/ios/Flutter/.last_build_id
zbudget/.dart_tool/
zbudget/.flutter-plugins-dependencies
zbudget/.packages
zbudget/.pub-cache/
zbudget/.pub/
zbudget/build/
zbudget/coverage/

# Symbolication related
zbudget/app.*.symbols

# Obfuscation related
zbudget/app.*.map.json

# Android Studio will place build artifacts here
zbudget/android/app/debug
zbudget/android/app/profile
zbudget/android/app/release

# Flutter build outputs
zbudget/build/
zbudget/.dart_tool/

# Android specific
zbudget/android/gradle/
zbudget/android/.gradle/
zbudget/android/gradlew
zbudget/android/gradlew.bat
zbudget/android/local.properties
zbudget/android/gradle.properties
zbudget/android/app/release/
zbudget/android/app/debug/
zbudget/android/app/profile/

# iOS specific
zbudget/ios/Flutter/flutter_export_environment.sh
zbudget/ios/Flutter/Generated.xcconfig
zbudget/ios/Flutter/flutter_export_environment.sh
zbudget/ios/Runner.xcworkspace/
zbudget/ios/Pods/
zbudget/ios/.symlinks/

# macOS specific
zbudget/macos/Flutter/ephemeral/
zbudget/macos/Flutter/GeneratedPluginRegistrant.swift

# Linux specific
zbudget/linux/flutter/ephemeral/

# Windows specific
zbudget/windows/flutter/ephemeral/

# Web specific
zbudget/web/

# ===============================
# Sensitive files
# ===============================

# Configuration files with secrets
zbudget/android/app/google-services.json
zbudget/ios/Runner/GoogleService-Info.plist
Backend/.env*
Backend/config/database.js
Backend/config/auth.js
Backend/keys/
Backend/secrets/

# Local development environment files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# SSL certificates
*.pem
*.key
*.crt
*.p12

# ===============================
# Development and temporary files
# ===============================

# Temporary files
*.tmp
*.temp
temp/
tmp/

# Backup files
*.bak
*.backup

# Local development files
.local/
local/

# Test files
test_results/
test_output/

# Cache directories
.cache/
cache/

# ===============================
# Git related
# ===============================

# Ignore git hooks (optional)
# .git/hooks/

# Serena (AI assistant) files
.serena/

# MCP configuration (may contain sensitive connection strings)
.mcp.json

# ===============================
# Additional project-specific
# ===============================

# Flutter build artifacts that might be generated
*.dill
*.track.dill

# Any custom scripts or tools output
scripts/output/
tools/output/

# ===============================
# Documentation files to ignore
# ===============================

# Temporary documentation and reports
*_REPORT.md
*_FIXES_REPORT.md
*_IMPLEMENTATION.md
*_COMPLETION_REPORT.md
*_INTEGRATION_TEST_REPORT.md
*_SETUP_GUIDE.md
*_FIXES_SUMMARY.md
*_ANALYSIS_AND_RECOMMENDATIONS.md
*_SOLUTION.md
*_IMPLEMENTATION_COMPLETE.md
CLAUDE.md

# ===============================
# React Native / Expo (not used - Flutter project)
# ===============================
.expo/
.expo-shared/

# ===============================
# Test and backup files
# ===============================
*_backup.*
*.backup
test-*.js
server.log